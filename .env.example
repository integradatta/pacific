# ─────────────────────────────────────────────────────────────────────────────
# Pacific — variáveis de ambiente (exemplo). Copie para `.env` (API) e
# `apps/web/.env.local` (web). NUNCA versione os valores reais. Ver docs/RECOVERY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados (Prisma/Supabase Postgres) ───────────────────────────────
# DATABASE_URL: conexão de RUNTIME (pooler 6543, role `pacific_app` NÃO-dona → RLS).
DATABASE_URL="postgresql://pacific:pacific@localhost:5432/pacific?schema=public"
# DIRECT_URL: conexão DONA (5432) usada só para migrações e `db:rls`. Fica em packages/database/.env.
# DIRECT_URL="postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres"

# ── Supabase (auth do credor/admin via JWT assimétrico) ─────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""   # SEGREDO — só no servidor, nunca no web
SUPABASE_JWT_SECRET=""         # (legado) — a validação usa a JWKS pública do projeto

# ── Auth do devedor (magic link, JWT HS256) ─────────────────────────────────
APP_JWT_SECRET=""   # OBRIGATÓRIO em produção — assina/valida o JWT do devedor. Gere: openssl rand -base64 48

# ── Rate limiting / throttling ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"   # sem ele, o throttler cai para in-memory (1 réplica)
THROTTLE_TTL_MS="60000"              # janela do throttler GLOBAL por IP
THROTTLE_LIMIT="300"                 # req/janela do throttler global
REDEEM_RATE_LIMIT="10"               # limite estrito do endpoint de redeem (magic link)
REDEEM_RATE_WINDOW_MS="600000"

# ── Servidor / CORS ─────────────────────────────────────────────────────────
API_PORT="3333"
WEB_ORIGIN="http://localhost:3000"   # OBRIGATÓRIO em produção — origem(ns) do web (CSV)
NODE_ENV="development"

# ── Segurança RLS (defesa em profundidade) ──────────────────────────────────
RLS_STRICT="off"          # em PRODUÇÃO deixe ON (fail-closed): boot exige FORCE RLS nas tabelas
RLS_HEALTHCHECK="on"      # roda o healthcheck de RLS no boot

# ── Observabilidade ─────────────────────────────────────────────────────────
SENTRY_DSN=""             # no-op se vazio

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=""       # gere: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""      # SEGREDO — só no servidor
VAPID_SUBJECT="mailto:voce@exemplo.com"

# ── Retenção de dados (jobs de expurgo; dias) ───────────────────────────────
RETENTION_DAYS="90"
LOCATION_RETENTION_DAYS="30"
SNAPSHOT_RETENTION_DAYS="365"
TRASH_RETENTION_DAYS="30"

# ── Ajustes de localização (opcionais; têm default no código) ───────────────
# LOCATION_ONLINE_WINDOW_MS, LOCATION_MAX_FUTURE_SKEW_MS, GEOFENCE_CACHE_TTL_MS

# ─────────────────────────────────────────────────────────────────────────────
# Portal web (apps/web/.env.local) — NEXT_PUBLIC_* vão para o bundle do cliente
# (visíveis no navegador). NUNCA coloque segredos aqui.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""          # chave ANÔNIMA (pública), não a service role
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""           # = VAPID_PUBLIC_KEY (pública)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_MAP_TILE_URL=""               # opcional — tiles do mapa de localização
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""
