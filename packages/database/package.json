{
  "name": "@pacific/database",
  "version": "0.1.0",
  "main": "./src/client.ts",
  "scripts": {
    "db:generate": "prisma generate --schema=schema.prisma",
    "db:migrate": "prisma migrate dev --schema=schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=schema.prisma",
    "db:rls": "psql \"${DIRECT_URL:?defina DIRECT_URL (conexão dona) para aplicar a RLS}\" -v ON_ERROR_STOP=1 -f src/rls.sql",
    "db:release": "prisma migrate deploy --schema=schema.prisma && npm run db:rls",
    "db:seed": "tsx seed.ts",
    "lint": "DATABASE_URL=\"${DATABASE_URL:-postgresql://validate:validate@localhost:5432/validate}\" DIRECT_URL=\"${DIRECT_URL:-postgresql://validate:validate@localhost:5432/validate}\" prisma validate --schema=schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "tsx": "^4.16.0"
  }
}
