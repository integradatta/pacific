# Modelo — copie para `keystore.properties` (que está no .gitignore) e preencha.
# O signingConfig do Gradle (native-templates/app-build.gradle.signing.snippet) lê estes valores.
#
# NOTA: durante a preparação automática, um `keystore.properties` real JÁ foi gerado com uma senha
# forte aleatória (está no .gitignore). A keystore em si ainda precisa ser criada com `keytool`
# — o comando exato está em QUANDO_EU_VOLTAR.md.

storeFile=pacific-upload.keystore
storePassword=COLOQUE_UMA_SENHA_FORTE
keyAlias=pacific-upload
keyPassword=COLOQUE_UMA_SENHA_FORTE
